{
  "name": "learning-buddy-electron",
  "productName": "LearningBuddy",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "LearningBuddy v2 : assistant de révision Electron avec compagnon Three.js (TSL).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node dev.mjs",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "test:e2e": "node build.mjs && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.learningbuddy.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets/default-packages",
        "to": "default-packages"
      }
    ],
    "win": {
      "icon": "../assets/app.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
